# SunTriX API — environment reference
#
# ENV-ONLY: secrets and auth settings. Read from the environment only; the
#   Admin → Settings page cannot read or change them, and DB rows are ignored.
# DB-OVERRIDABLE: everything else. The value here is the default; an admin can
#   override it in Admin → Settings without a restart. Leave blank to use the
#   built-in default.
# The server refuses to start if a required value is missing or malformed
# (see src/config/env.ts).

# ─── Server ─────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Log level: fatal|error|warn|info|debug|silent (default: info in production, debug otherwise, silent in tests).
# Logs are JSON lines (pretty-printed when NODE_ENV=development); capability tokens in URLs are redacted.
LOG_LEVEL=
# Optional monitoring (see PlatformDocumentation.md §12.5). ENV-ONLY.
SENTRY_DSN=                                          # report 5xx errors to Sentry (scrubbed of tokens/PII)
METRICS_TOKEN=                                       # enables GET /metrics with Authorization: Bearer <token>
GIT_SHA=                                             # build revision, used as the Sentry release
FRONTEND_URL=http://localhost:8080                 # ENV-ONLY, required; CORS origin and link base for emails
CORS_ORIGINS=                                      # ENV-ONLY, optional extra allowed origins, comma-separated (e.g. a staging site)
                                                   # localhost:8080/5173/3000 are allowed automatically outside production
TRUST_PROXY=                                       # ENV-ONLY; number of reverse proxies in front of the app (e.g. 1), "loopback" or a CIDR list. Unset = trust none

# ─── Database (ENV-ONLY, required) ──────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/suntrix

# ─── Auth (ENV-ONLY) ────────────────────────────────────────────
# Required, at least 32 characters each, and different from each other.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRY=15m                                     # access token lifetime (refresh tokens last 7 days and rotate)

# ─── Stripe (ENV-ONLY, required in production) ──────────────────
STRIPE_SECRET_KEY=                                 # sk_test_… / sk_live_…
STRIPE_WEBHOOK_SECRET=                             # whsec_… — webhooks are rejected without it

# ─── Email via Resend (RESEND_API_KEY is ENV-ONLY, required in production) ─
RESEND_API_KEY=                                    # re_…
EMAIL_FROM=                                        # DB-overridable, e.g. "SunTriX <hello@yourdomain.com>"
FROM_EMAIL_NAME=SunTriX                            # DB-overridable
FROM_EMAIL_ADDRESS=                                # DB-overridable
ADMIN_EMAIL=admin@yourdomain.com                   # DB-overridable; receives admin notifications
ADMIN_NOTIFICATION_EMAIL=                          # DB-overridable
EMAIL_CONTACT_NOTIFICATIONS=true                   # DB-overridable
EMAIL_TASK_NOTIFICATIONS=true                      # DB-overridable
EMAIL_KICKOFF_SLA=                                 # DB-overridable
EMAIL_PAYMENT_SLA=                                 # DB-overridable

# ─── Cloudinary (ENV-ONLY; all three required in production) ─
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_DEFAULT_FOLDER=suntrix                      # DB-overridable
UPLOAD_MAX_SIZE_MB=50                              # DB-overridable

# ─── Groq AI (GROQ_API_KEY is ENV-ONLY; the rest DB-overridable) ─
GROQ_API_KEY=                                      # gsk_… — chatbot and AI drafting are disabled without it
AI_ENABLED=true
GROQ_CHAT_MODEL=llama-3.1-8b-instant
GROQ_EXTRACT_MODEL=llama-3.1-8b-instant
GROQ_CHAT_TEMPERATURE=0.7
GROQ_CHAT_MAX_TOKENS=1024
GROQ_EMAIL_TEMPERATURE=
GROQ_EMAIL_MAX_TOKENS=

# ─── Chatbot (DB-overridable) ───────────────────────────────────
CHATBOT_ENABLED=true
CHATBOT_NAME=
CHATBOT_WELCOME_MESSAGE=
CHATBOT_SYSTEM_PROMPT=
CHATBOT_MAX_WORDS=
CHATBOT_CONTACT_LINK=
CHATBOT_PORTFOLIO_LINK=
CHATBOT_PRICING_LINK=

# ─── Brand (DB-overridable) ─────────────────────────────────────
BRAND_NAME=
BRAND_EMAIL=
BRAND_WEBSITE=
BRAND_TAGLINE=
BRAND_RESPONSE_TIME=
BRAND_PROPOSAL_GUARANTEE=

# ─── Newsletter (DB-overridable) ────────────────────────────────
NEWSLETTER_DOUBLE_OPTIN=false
NEWSLETTER_BATCH_SIZE=
NEWSLETTER_FOOTER_TEXT=

# ─── Operations (DB-overridable) ────────────────────────────────
MAINTENANCE_MODE=false
RATE_LIMIT_MAX=500                                 # requests per 15 min per IP
RATE_LIMIT_AUTH_MAX=5                              # login/forgot/reset attempts per 15 min per IP
RATE_LIMIT_CONTACT=5                               # form submissions per hour per IP
RATE_LIMIT_CHAT=10                                 # chat messages per minute per IP
AUDIT_LOG_RETENTION_DAYS=

# ─── First Admin (npm run seed:admin — idempotent) ──────────────
# Password: at least 12 characters. Remove these from the environment after seeding.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Admin
